[Unit]
Description=Assistant backend
After=network.target

[Service]
User=pi
WorkingDirectory=/home/alexis/assistant/backend
EnvironmentFile=/home/alexis/assistant/deploy/.env
ExecStart=/home/alexis/assistant-env/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
